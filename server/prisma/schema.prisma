generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  holdings  Holdings[]
}

model Holdings {
  id           String        @id @default(cuid())
  coinId       String
  userId       String
  note         String?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  tags         Tag[]         @relation("HoldingsToTag")

  @@unique([userId, coinId]) // Ensure a user can't have duplicate holdings for the same coin
}

model Tag {
  id       String     @id @default(cuid())
  name     String
  holdings Holdings[] @relation("HoldingsToTag")
}

model Transaction {
  id           String          @id @default(cuid())
  holdingId    String
  type         TransactionType
  quantity     Decimal
  pricePerUnit Decimal
  date         DateTime
  note         String?
  isRecurring  Boolean         @default(false)
  createdAt    DateTime        @default(now())
  holding      Holdings        @relation(fields: [holdingId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  BUY
  SELL
}
